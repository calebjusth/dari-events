---
const title = 'QR Verification';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="robots" content="noindex, nofollow" />
		<style>
			:global(*) { box-sizing: border-box; }
			:global(html), :global(body) { margin: 0; min-height: 100%; }
			:global(body) { background: #111; color: #fff; font-family: system-ui, sans-serif; }
			main { min-height: 100vh; display: grid; place-items: center; padding: 16px; }
			.app { width: min(100%, 520px); text-align: center; }
			h1 { font-size: 1.25rem; margin: 0 0 16px; }
			.camera { position: relative; width: 100%; aspect-ratio: 3 / 4; overflow: hidden; background: #000; }
			video { display: block; width: 100%; height: 100%; object-fit: cover; }
			.frame { position: absolute; inset: 15%; border: 3px solid #fff; pointer-events: none; }
			#status { min-height: 48px; padding: 16px 0 8px; font-size: 1.1rem; }
			#next { width: 100%; padding: 16px; border: 0; border-radius: 6px; background: #fff; color: #111; font-size: 1.1rem; font-weight: 700; cursor: pointer; }
			#next[hidden] { display: none; }
			.error { color: #ff8c8c; }
			.valid { color: #8cffaa; }
		</style>
	</head>
	<body>
		<main>
			<section class="app" aria-live="polite">
				<h1>QR VERIFICATION</h1>
				<div class="camera">
					<video id="camera" autoplay muted playsinline></video>
					<div class="frame" aria-hidden="true"></div>
				</div>
				<div id="status">Requesting camera access...</div>
				<button id="next" type="button" hidden>SCAN NEXT</button>
			</section>
		</main>

		<script>
			import QrScanner from 'qr-scanner';
			import workerUrl from 'qr-scanner/qr-scanner-worker.min.js?url';

			QrScanner.WORKER_PATH = workerUrl;

			const video = document.querySelector<HTMLVideoElement>('#camera');
			const status = document.querySelector<HTMLElement>('#status');
			const nextButton = document.querySelector<HTMLButtonElement>('#next');
			let isScanning = false;

			if (!video || !status || !nextButton) {
				throw new Error('Scanner elements are missing from the page.');
			}

			const videoElement = video;
			const statusElement = status;
			const scanNextButton = nextButton;
			let scanner: QrScanner;

			function getToken(value: string): string | null {
				const content = value.trim();
				if (!content) return null;

				try {
					const url = new URL(content);
					const parts = url.pathname.split('/').filter(Boolean);
					const versionIndex = parts.indexOf('v');
					return parts[versionIndex + 1] || parts.at(-1) || null;
				} catch {
					return content;
				}
			}

			function showStatus(message: string, className = '') {
				statusElement.textContent = message;
				statusElement.className = className;
			}

			async function verify(decodedText: string) {
				if (!isScanning) return;
				isScanning = false;
				await scanner.stop();
				showStatus('Checking QR code...');

				const token = getToken(decodedText);
				try {
					const response = await fetch('/api/verify', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ token }),
					});
					const result = await response.json();

					if (response.ok && result.valid) {
						showStatus('VALID QR CODE', 'valid');
					} else {
						showStatus('NO QR CODE FOUND', 'error');
					}
				} catch (error: unknown) {
					console.error('QR verification failed', error);
					showStatus('Could not verify QR code. Try again.', 'error');
				}

				scanNextButton.hidden = false;
			}

			async function startScanning() {
				scanNextButton.hidden = true;
				showStatus('Requesting camera access...');

				try {
					if (!navigator.mediaDevices?.getUserMedia) {
						throw new Error('Camera access is not supported by this browser.');
					}

					  await scanner.start();
					isScanning = true;
					showStatus('Point the camera at a QR code.');
				} catch (error: unknown) {
					console.error('Camera start failed', error);
					isScanning = false;
					const errorName = error instanceof DOMException ? error.name : '';
					const message = errorName === 'NotAllowedError'
						? 'Camera permission is required. Allow camera access and reload this page.'
						: errorName === 'NotFoundError'
							? 'No camera was found on this device.'
							: 'Unable to open the camera. Check browser permissions and try again.';
					showStatus(message, 'error');
					scanNextButton.hidden = false;
				}
			}

			scanner = new QrScanner(videoElement, (decodedText: string) => {
				verify(decodedText);
			});

			scanNextButton.addEventListener('click', startScanning);
			window.addEventListener('pagehide', () => scanner.destroy());
			startScanning();
		</script>
	</body>
</html>
